{
  "name": "wikipedia-through-time",
  "version": "0.0.0",
  "private": true,

  "scripts": {
    "build": "turbo run build",
    "db": "docker compose up --detach --wait",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },

  "devDependencies": {
    "turbo": "^2"
  },

  "engines": {
    "node": ">=24"
  },

  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11"
    }
  },

  "workspaces": ["apps/*", "agents/*", "packages/*"],

  "overrides": {
    "eslint": "^10",

    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },

    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  },

  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  }
}
