{
  "name": "wikipedia-through-time",
  "version": "0.0.0",
  "private": true,

  "scripts": {
    "build": "turbo run build",
    "db": "docker compose up --detach --wait",
    "dev": "turbo run dev",
    "embed": "npm run embed -w @wtt/package-ingest",
    "evaluate": "npm run evaluate -w @wtt/package-ingest",
    "lint": "turbo run lint",
    "load": "npm run migrate -w @wtt/package-db && npm run load -w @wtt/package-ingest",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "npm run validate -w @wtt/package-ingest"
  },

  "devDependencies": {
    "turbo": "^2"
  },

  "engines": {
    "node": ">=24"
  },

  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11"
    }
  },

  "workspaces": ["apps/*", "agents/*", "packages/*"],

  "overrides": {
    "eslint": "^10",

    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },

    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  },

  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  }
}
