{
  "name": "@wtt/package-ingest",
  "version": "0.0.0",
  "private": true,

  "type": "module",

  "scripts": {
    "bench": "node bench.ts --out ../../apps/web/content/latency.json",
    "embed": "node embed.ts",
    "evaluate": "node evaluate.ts --out ../../apps/web/content/evaluation.json",
    "load": "node articles.ts && node revisions.ts && node edits.ts && node passages.ts && node terms.ts && node offices.ts",
    "test": "vitest --run",
    "typecheck": "tsc",
    "validate": "node validate.ts --out ../../apps/web/content/validation.json"
  },

  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@wtt/package-db": "0.0.0",
    "@wtt/package-engine": "0.0.0",
    "@wtt/package-models": "0.0.0",
    "@wtt/package-wikitext": "0.0.0",
    "fractional-indexing": "4.0.0"
  },

  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5",
    "vitest": "^5"
  }
}
